@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav

<MudPaper Class="pa-6 mx-auto mt-10" MaxWidth="400px">
    <MudForm @ref="form" @bind-IsValid="@isValid">
        <MudText Typo="Typo.h5" Class="mb-4">Sign In</MudText>

        <MudTextField @bind-Value="Email"
                      Label="Email"
                      Required="true"
                      RequiredError="Email is required."
                      Validation="@(new EmailAddressAttribute() { ErrorMessage = "Invalid email format." })" />

        <MudTextField @bind-Value="Password"
                      Label="Password"
                      InputType="InputType.Password"
                      Required="true"
                      RequiredError="Password is required." />

        <MudButton Variant="MudBlazor.Variant.Filled"
                   Color="Color.Primary"
                   Disabled="!isValid || isLoggingIn"
                   OnClick="HandleLogin"
                   Class="mt-4 w-100">
            @if (isLoggingIn)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Typo="Typo.button" Class="ms-2">Logging In...</MudText>
            }
            else
            {
                <MudText Typo="Typo.button">Log In</MudText>
            }
        </MudButton>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@ErrorMessage</MudAlert>
        }

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle2" Align="Align.Center">
            Don’t have an account?
            <MudLink Href="/register">Register here</MudLink>
            <MudButton OnClick="NavigateToGoogle"
                       Color="Color.Primary"
                       Variant="MudBlazor.Variant.Outlined"
                       StartIcon="@(isNavigating ? null : Icons.Material.Filled.Login)"
                       Disabled="@isNavigating">
                @if (isNavigating)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Typo="Typo.button" Class="ms-2">Navigating to Google...</MudText>
                }
                else
                {
                    <MudText Typo="Typo.button">Continue with Google</MudText>
                }
            </MudButton>
        </MudText>
    </MudForm>
</MudPaper>

@code {
    [Parameter] public EventCallback<(string Email, string Password)> OnSubmit { get; set; }

    private MudForm form;
    private bool isValid;
    private bool isLoggingIn;
    private bool isNavigating;
    private string Email = string.Empty;
    private string Password = string.Empty;
    private string? ErrorMessage;

    private async Task HandleLogin()
    {
        isLoggingIn = true;
        await form.Validate();
        if (isValid)
        {
            await OnSubmit.InvokeAsync((Email, Password));
        }
        isLoggingIn = false;
    }

    private async Task NavigateToGoogle()
    {
        isNavigating = true;

        var url = Nav.BaseUri.Contains("localhost")
        ? "https://localhost:7191/api/auth/external/Google?returnUrl=/signin-external"
        : "https://hipsdontlie.live/api/auth/external/Google?returnUrl=/signin-external";

        Nav.NavigateTo(url, forceLoad: true);
    }
}