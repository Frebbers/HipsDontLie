@using System.ComponentModel.Design

<MudButton Variant="MudBlazor.Variant.Filled"
           Disabled="@isWaiting"
           OnClick="OnButtonPressed">

    @if (isWaiting)
    {
        <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" />
        <text>Joining...</text>
    }
    else
    {
        <text>Join course</text>
    }

</MudButton>

@code
{
    [Parameter] public int CourseId { get; set; }
    [Parameter] public EventCallback OnJoinRequested { get; set; }

    private bool isWaiting = false;

    private async Task OnButtonPressed()
    {
        isWaiting = true;

        try
        {
            await OnJoinRequested.InvokeAsync(CourseId);
        }
        catch (Exception ex)
        {
            //TODO: Implement proper error handling (e.g., show a message to the user)
            Console.Error.WriteLine($"JoinCourseButton error: {ex.Message}");
        }
        finally
        {
            isWaiting = false;
        }
    }
}
