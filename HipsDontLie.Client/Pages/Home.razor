}

<style>
    .home-root {
        min-height: calc(100vh - 64px);
        padding: 3rem 1.5rem;
    }

    .main-card {
        padding: 2.5rem 2rem;
        border-radius: 24px;
        background: #5e50e012;
        color: black;
    }

    .home-feature-card {
        padding: 1.5rem 1.25rem;
        border-radius: 20px;
        text-align: left;
        background: #5e50e012;
        color: black;
    }

        .home-feature-card .mud-icon-root {
            opacity: 0.9;
        }

    .home-muted {
        opacity: 0.8;
    }

    @@media (max-width: 600px) {
        .main-card p {
            font-size: 14px;
        }
    }
</style>
