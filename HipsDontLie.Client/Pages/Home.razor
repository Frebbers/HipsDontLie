@page "/"

<MudContainer MaxWidth="MaxWidth.False" Class="home-root">
    <MudGrid Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="4">
        <MudItem xs="12" md="6">
            <MudPaper Elevation="8" Class="main-card">
                <AuthorizeView Context="auth">
                    <Authorized>
                        <MudText Typo="Typo.h3" Class="mb-2">
                            Welcome, @auth.User.Identity?.Name!
                        </MudText>
                        <MudStack Row="true" Spacing="1" Class="mb-3">
                            <AuthorizeView Roles="Instructor">
                                <MudChip T="string"
                                         Variant="MudBlazor.Variant.Filled"
                                         Color="Color.Primary"
                                         Icon="@Icons.Material.Filled.School">
                                    Instructor
                                </MudChip>
                            </AuthorizeView>

                            <AuthorizeView Roles="Participant">
                                <MudChip T="string"
                                         Variant="MudBlazor.Variant.Filled"
                                         Color="Color.Secondary"
                                         Icon="@Icons.Material.Filled.Man4">
                                    Participant
                                </MudChip>
                            </AuthorizeView>
                        </MudStack>

                        <MudText Typo="Typo.subtitle1" Class="mb-4">
                            Welcome to HipsDontLie — your platform for structured, community-driven training.
                            Browse courses, join groups, track your schedule, and progress alongside others at your own pace.
                        </MudText>

                        <MudStack Spacing="2">
                            <MudButton Href="/profile"
                                       Color="Color.Secondary"
                                       Variant="MudBlazor.Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.AccountCircle">
                                View my profile
                            </MudButton>
                        </MudStack>
                    </Authorized>

                    <NotAuthorized>
                        <MudText Typo="Typo.h3" Class="mb-2">
                            Welcome to Hips Dont Lie
                        </MudText>
                        <MudText Typo="Typo.subtitle1" Class="mb-4">
                            Discover and join courses with people who have the same interests as you.
                        </MudText>

                        <MudStack Row="true" Spacing="2" Class="mb-4">
                            <MudButton Href="/login"
                                       Color="Color.Primary"
                                       Variant="MudBlazor.Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Login">
                                Log in
                            </MudButton>
                            <MudButton Href="/register"
                                       Color="Color.Secondary"
                                       Variant="MudBlazor.Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.PersonAdd">
                                Create account
                            </MudButton>
                        </MudStack>
                    </NotAuthorized>
                </AuthorizeView>
            </MudPaper>
        </MudItem>

        <AuthorizeView Context="auth2">
            <Authorized>
                <MudItem xs="12" md="5">
                    <MudGrid Justify="Justify.SpaceAround" Style="height: 100%;" Spacing="2">
                        <MudItem xs="12">
                            <MudPaper Elevation="6" Class="home-feature-card">
                                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Large" />
                                <MudText Typo="Typo.h6" Class="mt-2 mb-1">
                                    <MudButton Href="/courses"
                                               Color="Color.Primary"
                                               Variant="MudBlazor.Variant.Text"
                                               Style="padding: .2em 0px .2em 0px; font-size 1rem;">
                                        Find Courses
                                    </MudButton>
                                </MudText>
                                <MudText Typo="Typo.body2" Class="home-muted">
                                    Search for courses that match your interests and schedule.
                                </MudText>
                            </MudPaper>
                        </MudItem>

                        <AuthorizeView Roles="Instructor">
                            <MudItem xs="12" sm="6">
                                <MudPaper Elevation="6" Class="home-feature-card">
                                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Large" />
                                    <MudText Typo="Typo.h6" Class="mt-2 mb-1">
                                        <MudButton Href="/courses/create"
                                                   Color="Color.Primary"
                                                   Variant="MudBlazor.Variant.Text"
                                                   Style="padding: .2em 0px .2em 0px; font-size 1rem;">
                                            Create a Course
                                        </MudButton>
                                       </MudText>
                                    <MudText Typo="Typo.body2" Class="home-muted">
                                        Set up a new course and invite participants.
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                        </AuthorizeView>

                        <AuthorizeView Roles="Participant">
                            <MudItem xs="12" sm="@(auth2.User.IsInRole("Participant") && !auth2.User.IsInRole("Instructor") ? 12 : 6)">
                                <MudPaper Elevation="6" Class="home-feature-card">
                                    <MudIcon Icon="@Icons.Material.Filled.Favorite" Size="Size.Large" />
                                    <MudText Typo="Typo.h6" Class="mt-2 mb-1">
                                        <MudButton Href="/mycourses"
                                                   Color="Color.Primary"
                                                   Variant="MudBlazor.Variant.Text"
                                                   Style="padding: .2em 0px .2em 0px; font-size 1rem;">
                                            My Courses
                                        </MudButton>
                                        </MudText>
                                    <MudText Typo="Typo.body2" Class="home-muted">
                                        Get an overview of the courses you have joined.
                                    </MudText>
                                    
                                </MudPaper>
                            </MudItem>
                        </AuthorizeView>
                    </MudGrid>
                </MudItem>
            </Authorized>
        </AuthorizeView>
    </MudGrid>
</MudContainer>

