@page "/mycourses"
@using HipsDontLie.Client.Handlers
@using HipsDontLie.Client.Services
@using HipsDontLie.Shared.DTO
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@if (!string.IsNullOrWhiteSpace(_errorMessage)) {
    <MudAlert Severity="Severity.Error" Elevation="0" Class="mt-4">
        @_errorMessage
    </MudAlert>
}
else {
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
        <MudTabPanel Text="Course List">
            <CourseList GroupList="GroupList" />
        </MudTabPanel>
        <MudTabPanel Text="Calender">
            <AuthorizeView Roles="Instructor">
                <Authorized>
                    <Calender Appointments="Appointments"
                              CanEdit="true" />
                </Authorized>
                <NotAuthorized>
                    <Calender Appointments="Appointments"
                              CanEdit="false" />
                </NotAuthorized>
            </AuthorizeView>
        </MudTabPanel>
    </MudTabs>
}

@code {

    [Inject]
    public ResourceService ResourceService { get; set; }

    public List<GroupDTO> GroupList { get; set; } = new();
    public List<AppointmentDTO> Appointments { get; set; } = new();

    private string _errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try {
            GroupList = await ResourceService.GetAllGroups();
            Appointments = FetchAppointments();
        }
        catch (ApiException ex) {
            _errorMessage = $"{ex.Message} - {ex.StatusCode}: {(int)ex.StatusCode}";
        }
    }

    private List<AppointmentDTO> FetchAppointments() {
        return GroupList
            .Where(g => g.Appointments != null)
            .SelectMany(g => g.Appointments!)
            .ToList();
    }
}
