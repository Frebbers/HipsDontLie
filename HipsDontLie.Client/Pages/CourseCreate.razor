@page "/courses/create"
@using HipsDontLie.Client.Services
@using HipsDontLie.Shared.DTO
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Instructor")]

<h3>Create Group</h3>
@*THIS IS NOT THE FINAL IMPLEMENTATION - JUST FOR TEST*@
<EditForm Model="groupModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label class="form-label">Title</label>
        <InputText class="form-control" @bind-Value="groupModel.Title" />
    </div>
    <div class="form-check mb-3">
        <InputCheckbox class="form-check-input" @bind-Value="groupModel.IsVisible" />
        <label class="form-check-label">Visible to others</label>
    </div>
    <div class="mb-3">
        <label class="form-label">Age range</label>
        <InputText class="form-control" @bind-Value="groupModel.AgeRange" />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <InputTextArea class="form-control" @bind-Value="groupModel.Description" Rows="4" />
    </div>
    <div class="mb-3">
        <label class="form-label">Max members</label>
        <InputNumber class="form-control" @bind-Value="groupModel.MaxMembers" />
    </div>
    <fieldset class="mb-3">
        <legend class="h6">Tags</legend>
        <div class="input-group mb-2">
            <InputText class="form-control" @bind-Value="newTag" placeholder="Add tag..." />
            <button type="button" class="btn btn-outline-secondary" @onclick="AddTag">Add</button>
        </div>
        @if (groupModel.Tags?.Count > 0) {
            <ul class="list-inline">
                @foreach (var tag in groupModel.Tags) {
                    <li class="list-inline-item badge bg-secondary me-1">
                        @tag
                    </li>
                }
            </ul>
        }
    </fieldset>
    <Calender OnAppointmentsChanged="HandleAppointmentsChanged"></Calender>
    <button type="submit" class="btn btn-primary">Create group</button>
</EditForm>
@code {
    [Inject]
    public ResourceService ResourceService { get; set; }

    private CreateGroupRequestDTO groupModel = new();
    private string? newTag;
    private string? newNonUserMember;

    private void HandleAppointmentsChanged(List<AppointmentDTO> appointments)
    {
        groupModel.Appointments = appointments;
    }

    private void AddTag() {
        if (!string.IsNullOrWhiteSpace(newTag)) {
            groupModel.Tags ??= new List<string>();
            groupModel.Tags.Add(newTag.Trim());
            newTag = string.Empty;
        }
    }

    private async void HandleValidSubmit() {
        await ResourceService.CreateGroup(groupModel);
    }
}