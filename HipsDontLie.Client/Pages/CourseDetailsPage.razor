@page "/courses/{id:int}"
@using HipsDontLie.Client.Services
@using HipsDontLie.Shared.DTO

<h3>@Course.Title</h3>
<MudGrid>
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Course Description</MudText>
            <MudText Typo="Typo.body1">@Course.Description</MudText>
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.h6">Age Range</MudText>
            <MudText Typo="Typo.body1">@Course.AgeRange</MudText>
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.h6">Participants</MudText>
            <MudText Typo="Typo.body1">@Course.Members.Count()/@Course.MaxMembers</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
         <InstructorInfo Instructor="Instructor" /> 
    </MudItem>
</MudGrid>

@code {
    [Parameter] public int id { get; set; }
    // get course details by id
    public GroupDTO Course { get; set; } = new();
    public ProfileDTO Instructor { get; set; } = new();
    [Inject]
    public ResourceService ResourceService { get; set; }

    protected override async Task OnParametersSetAsync()
    {
       Course = await ResourceService.GetGroupByID(id);
       Instructor = await ResourceService.GetProfile(Course.OwnerId);
    }

}
