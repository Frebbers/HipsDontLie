@page "/courses/{id:int}"
@using HipsDontLie.Client.Handlers
@using HipsDontLie.Client.Services
@using HipsDontLie.Shared.DTO
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@attribute [Authorize(Roles = "Instructor,Participant")]

<div class="d-flex justify-center mt-4">
    @if (_isLoading) {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage)) {
        <MudAlert Severity="Severity.Error" Elevation="0" Class="mt-4">
            @_errorMessage
        </MudAlert>
    }
    else if (groupModel is not null) {
        <Course Model="groupModel"
                IsNew="false"
                CanEdit="_isInstructor"
                IsMember="_isMember"
                OnSave="HandleUpdate"
                OnDelete="HandleDelete"
                OnJoin="HandleJoin"
                OnLeave="HandleLeave">
        </Course>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    [Inject] public ResourceService ResourceService { get; set; }
    [Inject] public NavigationManager NavigationManager { get; set; }
    [CascadingParameter] public Task<AuthenticationState> AuthStateTask { get; set; }

    private GroupDTO? groupModel;
    private bool _isLoading;
    private string _errorMessage = "";
    private bool _isInstructor;
    private bool _isMember;
    private int _currentUserId;

    protected override async Task OnInitializedAsync() {
        _isLoading = true;

        try {
            var authState = await AuthStateTask;
            var user = authState.User;
            _isInstructor = authState.User.IsInRole("Instructor");
            _currentUserId = int.Parse(user.FindFirst(ClaimTypes.NameIdentifier)!.Value);

            GroupDTO group = await ResourceService.GetGroupByID(Id);

            _isMember = group.Members.Any(m => m.UserId == _currentUserId);

            groupModel = new GroupDTO {
                Title = group.Title,
                Description = group.Description,
                IsVisible = group.IsVisible,
                AgeRange = group.AgeRange,
                Members = group.Members,
                MaxMembers = group.MaxMembers,
                Tags = group.Tags,
                Appointments = group.Appointments
            };
        }
        catch (ApiException ex) {
            _errorMessage = $"{ex.Message} - {ex.StatusCode}: {(int)ex.StatusCode}";
        }
        finally {
            _isLoading = false;
        }
    }

    private async Task HandleUpdate(GroupDTO model) {
        try {
            await ResourceService.UpdateGroup(Id, model);
        }
        catch (ApiException ex) {
            _errorMessage = $"{ex.Message} - {ex.StatusCode}: {(int)ex.StatusCode}";
        }
    }

    private async Task HandleDelete() {
        try {
            await ResourceService.DeleteGroup(Id);
            NavigationManager.NavigateTo("/courses");
        }
        catch (ApiException ex) {
            _errorMessage = $"{ex.Message} - {ex.StatusCode}: {(int)ex.StatusCode}";
        }
    }


    private async Task HandleJoin() {
        try {
            await ResourceService.JoinGroup(Id);
            _isMember = true;
            StateHasChanged();
        }
        catch (ApiException ex) {
            _errorMessage = $"{ex.Message} - {ex.StatusCode}: {(int)ex.StatusCode}";
        }
    }

    private async Task HandleLeave() {
        try {
            await ResourceService.LeaveGroup(Id);
            _isMember = false;
            StateHasChanged();
        }
        catch (ApiException ex) {
            _errorMessage = $"{ex.Message} - {ex.StatusCode}: {(int)ex.StatusCode}";
        }
    }
}
