@page "/profile"
@using HipsDontLie.Client.Handlers
@using HipsDontLie.Client.Services
@using HipsDontLie.Shared.DTO
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@if (isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    @if (_errorStatusCode == 404)
    {
        <CreateProfileForm OnSubmit="HandleCreateProfile" />
    } else
    {
        <MudAlert Severity="Severity.Error" Elevation="0" Class="mt-4">
            @_errorMessage
        </MudAlert>
    }
}
else
{
    <MudCard Elevation="25" Class="rounded-lg pb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Align="Align.Center">Profile Info</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <div class="d-flex justify-center">
                <MudAvatar Size="MudBlazor.Size.Large" Color="Color.Primary">
                    @{
                        var username = Profile.Username ?? string.Empty;
                        var initial = !string.IsNullOrWhiteSpace(username)
                        ? char.ToUpper(username[0])
                        : '?';
                    }
                @initial
            </MudAvatar>
        </div>
        <MudList ReadOnly="true" T="string" Class="mx-auto mt-4" Style="width:300px;">
            <MudListItem Icon="@Icons.Material.Filled.Favorite">
                @(!string.IsNullOrWhiteSpace(Profile.Username) ? Profile.Username : "No username")
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Favorite">
                @(string.IsNullOrWhiteSpace(Profile.Region) ? "No region" : Profile.Region)
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Favorite">
                @(Profile.BirthDate == default
                                        ? "No birthdate"
                                        : Profile.BirthDate.ToString("dd-MM-yyyy"))
            </MudListItem>
        </MudList>
    </MudCardContent>

        <MudText Style="font-weight: 600;" Class="d-flex justify-center">Description:</MudText>
        <MudCardActions Class="d-flex justify-center">
            @(string.IsNullOrWhiteSpace(Profile.Description) ? "No description" : Profile.Description)
        </MudCardActions>
    </MudCard>
}

@code {

    public ProfileDTO Profile { get; set; } = new();
    public UpdateProfileRequestDTO UpdateProfile { get; set; }

    private string _errorMessage = "";
    private int _errorStatusCode;

    [Inject]
    public ResourceService ResourceService { get; set; }

    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            Profile = await ResourceService.GetProfile();
        }
        catch (ApiException ex)
        {
            _errorStatusCode = (int)ex.StatusCode;
            _errorMessage = $"{ex.Message} - {ex.StatusCode}: {(int)ex.StatusCode}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleCreateProfile((DateTime? BirthDate, string Region, string Description) formData)
    {
        UpdateProfile = new UpdateProfileRequestDTO()
        {
            BirthDate = formData.BirthDate ?? DateTime.Now,
            Description = formData.Description,
            Region = formData.Region,
            ProfilePicture = ""
        };

        try
        {
            var result = await ResourceService.UpdateProfile(UpdateProfile);
            Profile = await ResourceService.GetProfile();

            _errorStatusCode = 0;
            _errorMessage = string.Empty;
        }
        catch (ApiException ex)
        {
            _errorStatusCode = (int)ex.StatusCode;
            _errorMessage = $"{ex.Message} - {ex.StatusCode}: {(int)ex.StatusCode}";
        }
    }

}
