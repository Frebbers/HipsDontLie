@page "/profile"
@using HipsDontLie.Client.Handlers
@using HipsDontLie.Client.Services
@using HipsDontLie.Shared.DTO
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@if (isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Elevation="0" Class="mt-4">
        @_errorMessage
    </MudAlert>
}
else
{
    <MudGrid Style="margin-top: 1em;" Spacing="4">
        <MudItem xs="12" md="6">
            <MudCard Elevation="25" Class="rounded-lg pb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5" Align="Align.Center">Profile Info</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <div class="d-flex justify-center">
                        <MudAvatar Size="MudBlazor.Size.Large" Color="Color.Primary">
                            @{
                                var username = Profile.Username ?? string.Empty;
                                var initial = !string.IsNullOrWhiteSpace(username)
                                ? char.ToUpper(username[0])
                                : '?';
                            }
                        @initial
                    </MudAvatar>
                </div>
                <MudList ReadOnly="true" T="string" Class="mx-auto mt-4" Style="width:300px;">
                    <MudListItem Icon="@Icons.Material.Filled.Favorite">
                        @(!string.IsNullOrWhiteSpace(Profile.Username) ? Profile.Username : "No username")
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Favorite">
                        @(string.IsNullOrWhiteSpace(Profile.Region) ? "No region" : Profile.Region)
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Favorite">
                        @(Profile.BirthDate == default
                                                ? "No birthdate"
                                                : Profile.BirthDate.ToString("dd-MM-yyyy"))
                    </MudListItem>
                </MudList>
            </MudCardContent>

                <MudText Style="font-weight: 600;" Class="d-flex justify-center">Description:</MudText>
                <MudCardActions Class="d-flex justify-center">
                    @(string.IsNullOrWhiteSpace(Profile.Description) ? "No description" : Profile.Description)
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudText Typo="Typo.body1" Style="font-weight: 600; margin-bottom: 6px;">My Courses List</MudText>
            <MudStack Style="width: fit-content; align-items: center;">
            @if (GroupList is { Count: > 0 })
                {
                    @foreach (var item in GroupList)
                    {
                        <MudCard Style="width: 425px; border-radius: 6px;" Elevation="2">
                            <MudCardContent>
                                <MudText Style="text-align: center; margin-bottom: 4px;">@item.Title</MudText>
                                <MudDivider Style="border-color: black;" DividerType="DividerType.FullWidth" />
                                <MudStack Row="true" Style="margin-top: 4px;">
                                    <MudText Typo="Typo.body2"><strong>Age Range:</strong> @item.AgeRange</MudText>
                                    <MudSpacer></MudSpacer>
                                    <MudText Typo="Typo.body2"><strong>Owner Id:</strong> @item.OwnerId</MudText>
                                </MudStack>
                            </MudCardContent>
                            <MudCardActions Style="gap: 2px;">
                                @if (item.Tags is not null)
                                {
                                    @foreach (var tag in item.Tags)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="MudBlazor.Variant.Outlined" Color="Color.Info">
                                            @tag
                                        </MudChip>
                                    }
                                }
                            </MudCardActions>
                        </MudCard>
                    }
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mt-2">You are not in any groups yet.</MudText>
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {

    public ProfileDTO Profile { get; set; } = new();
    public List<GroupDTO> GroupList { get; set; } = new();

    private string _errorMessage = "";

    [Inject]
    public ResourceService ResourceService { get; set; }

    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            Profile = await ResourceService.GetProfile();
            GroupList = await ResourceService.GetUserGroups();
        }
        catch (ApiException ex)
        {
            _errorMessage = $"{ex.Message} - {ex.StatusCode}: {(int)ex.StatusCode}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
