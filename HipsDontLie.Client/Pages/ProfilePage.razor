@page "/profile"
@using HipsDontLie.Client.Services
@using HipsDontLie.Shared.DTO
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@if (isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
} else
{
    <MudContainer Style="height: 85vh; margin-top: 2rem;">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudCard Elevation="25" Class="rounded-lg pb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5" Align="Align.Center">Profile Info</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <div class="d-flex justify-center">
                            <MudAvatar Size="MudBlazor.Size.Large" Color="Color.Primary">@Profile.Username.ToUpper()[0]</MudAvatar>
                        </div>
                        <MudList ReadOnly="true" T="string" Class="mx-auto mt-4" Style="width:300px;">
                            <MudListItem Icon="@Icons.Material.Filled.Favorite">
                                @Profile.Username
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Favorite">
                                @Profile.Region
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Favorite">
                                @Profile.BirthDate.ToString("dd-MM-yyyy")
                            </MudListItem>
                        </MudList>
                    </MudCardContent>
                    <MudText Style="font-weight: 600;" Class="d-flex justify-center">Description:</MudText>
                    <MudCardActions Class="d-flex justify-center">
                        @Profile.Description
                    </MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 d-flex align-center justify-center" Style="flex-direction: column;">
                <MudText Typo="Typo.body1" Style="font-weight: 600; margin-bottom: 6px;">My Courses List</MudText>
                    <MudStack Style="width: 100%;">
                        @foreach (var item in GroupList)
                    {
                            <MudCard style="text-align: center;">
                                <MudCardContent>
                                    <MudText Style="padding-bottom: 0.5em;">@item.Title</MudText>
                                    <MudDivider />
                                    <MudText Style="margin-top: 6px;" Typo="Typo.body2">@item.Description</MudText>
                                </MudCardContent>
                                <MudDivider />
                                <MudCardActions Style="gap: 10px; justify-content: center;">
                                    @foreach (var tag in item.Tags)
                                    {
                                        <MudText Typo="Typo.caption">@tag</MudText>
                                    }
                                </MudCardActions>
                            </MudCard>
                    }
                    </MudStack>
                    </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
}

@code {

    public GetProfileResponseDTO Profile { get; set; } = new();
    public List<GroupDTO> GroupList { get; set; }

    [Inject]
    public ResourceService ResourceService { get; set; }

    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            Profile = await ResourceService.GetProfileAsync();
            GroupList = await ResourceService.GetUserGroupsAsync();
            Console.WriteLine(GroupList);
        }
        finally
        {
            isLoading = false;
        }
    }
}
