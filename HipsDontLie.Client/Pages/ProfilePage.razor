@page "/profile"
@using HipsDontLie.Client.Services
@using HipsDontLie.Shared.DTO
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@if (isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
} else
{
        <MudGrid Style="margin-top: 1em;" Spacing="4">
            <MudItem xs="12" md="6">
                <MudCard Elevation="25" Class="rounded-lg pb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5" Align="Align.Center">Profile Info</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <div class="d-flex justify-center">
                            <MudAvatar Size="MudBlazor.Size.Large" Color="Color.Primary">@Profile.Username.ToUpper()[0]</MudAvatar>
                        </div>
                        <MudList ReadOnly="true" T="string" Class="mx-auto mt-4" Style="width:300px;">
                            <MudListItem Icon="@Icons.Material.Filled.Favorite">
                                @Profile.Username
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Favorite">
                                @Profile.Region
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Favorite">
                                @Profile.BirthDate.ToString("dd-MM-yyyy")
                            </MudListItem>
                        </MudList>
                    </MudCardContent>
                    <MudText Style="font-weight: 600;" Class="d-flex justify-center">Description:</MudText>
                    <MudCardActions Class="d-flex justify-center">
                        @Profile.Description
                    </MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body1" Style="font-weight: 600; margin-bottom: 6px;">My Courses List</MudText>
                    <MudStack Style="width: fit-content; align-items: center;">
                        @foreach (var item in GroupList)
                    {
                           <MudCard Style="width: 425px; border-radius: 6px;"  Elevation="2">
                                <MudCardContent>
                                    <MudText Style="text-align: center; margin-bottom: 4px;">@item.Title</MudText>
                                    <MudDivider Style="border-color: black;"  DividerType="DividerType.FullWidth"/>
                                    <MudStack Row="true" Style="margin-top: 4px;">
                                        <MudText Typo="Typo.body2"><strong>Age Range:</strong> @item.AgeRange</MudText>
                                    <MudSpacer></MudSpacer>
                                    <MudText Typo="Typo.body2"><strong>Owner Id:</strong> @item.OwnerId</MudText>
                                    </MudStack>
                                </MudCardContent>
                                <MudCardActions Style="gap: 2px;">
                                    @foreach (var tag in item.Tags)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="MudBlazor.Variant.Outlined" Color="Color.Info">@tag</MudChip>
                                    }
                                </MudCardActions>
                            </MudCard>
                    }
                    </MudStack>
            </MudItem>
        </MudGrid>
}

@code {

    public ProfileDTO Profile { get; set; } = new();
    public List<GroupDTO> GroupList { get; set; }

    [Inject]
    public ResourceService ResourceService { get; set; }

    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            Profile = await ResourceService.GetProfile();
            GroupList = await ResourceService.GetUserGroups();
            Console.WriteLine(GroupList);
        }
        finally
        {
            isLoading = false;
        }
    }
}
