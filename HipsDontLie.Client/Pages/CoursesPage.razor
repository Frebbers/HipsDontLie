@page "/courses"
@using HipsDontLie.Client.Handlers
@using HipsDontLie.Client.Services
@using HipsDontLie.Shared.DTO
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Elevation="0" Class="mt-4">
        @_errorMessage
    </MudAlert>
}
else{
    <CourseList GroupList="GroupList" />
}

@code {

    [Inject]
    public ResourceService ResourceService { get; set; }

    public List<GroupDTO> GroupList { get; set; } = new();

    private string _errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            GroupList = await ResourceService.GetAllGroups();
        }
        catch (ApiException ex)
        {
            _errorMessage = $"{ex.Message} - {ex.StatusCode}: {(int)ex.StatusCode}";
        }
    }
}
