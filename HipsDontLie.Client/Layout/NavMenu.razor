<AuthorizeView>
    <Authorized Context="user">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All">Home</MudNavLink>

            <MudNavGroup Title="Courses" Expanded="true">
                <MudNavLink Href="/courses" Match="NavLinkMatch.Prefix">All Courses</MudNavLink>
                <MudNavLink Href="/mycourses" Match="NavLinkMatch.Prefix">My Courses</MudNavLink>

                <AuthorizeView Roles="Instructor">
                    <Authorized Context="Instructor">
                        <MudNavLink Href="/courses/create" Match="NavLinkMatch.Prefix">Create Course</MudNavLink>
                    </Authorized>
                </AuthorizeView>
            </MudNavGroup>

            <MudNavLink Href="/profile" Match="NavLinkMatch.Prefix">Profile</MudNavLink>
        </MudNavMenu>
    </Authorized>

    <NotAuthorized>
        <MudNavMenu>
            <MudNavLink Href="/about" Match="NavLinkMatch.Prefix">About</MudNavLink>
        </MudNavMenu>
    </NotAuthorized>
</AuthorizeView>
