@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">Hips Dont Lie</MudText>
        <MudSpacer />
        <MudIconButton Icon="" Color="Color.Inherit" Edge="Edge.End" />
        <AuthorizeView Context="auth">
            <Authorized>
            <MudMenu>
                <ActivatorContent>
                        <MudAvatar Size="MudBlazor.Size.Large" Color="Color.Dark">
                            @{
                                var username = auth.User.Identity.Name ?? string.Empty;
                                var initial = !string.IsNullOrWhiteSpace(username)
                                ? char.ToUpper(username[0])
                                : '?';
                            }
                            @initial
                        </MudAvatar>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Label="Profile" Href="/profile" />
                    <MudMenuItem Style="padding:0;">
                        <LoginDisplay />
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
            </Authorized>
            <NotAuthorized>
                <LoginDisplay />
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer Style="padding-top: 6px;" MaxWidth="MaxWidth.Large">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}